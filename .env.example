# Neon connection string. When you add Neon from the Vercel dashboard (Storage tab)
# this is set for you automatically. For local dev, copy it into .env.local
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Any long random string. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" so strangers can't trigger the scraper.
CRON_SECRET="change-me-to-a-long-random-string"
